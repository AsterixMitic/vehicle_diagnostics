<Project>

  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))" />

  <PropertyGroup>
    <!-- CA1707: test method names use xunit's sentence_style_with_underscores convention.
         CA1001: fixture lifetime is managed by xunit's IAsyncLifetime, not IDisposable. -->
    <NoWarn>$(NoWarn);CA1707;CA1001</NoWarn>
  </PropertyGroup>

</Project>
