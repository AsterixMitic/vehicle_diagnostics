<Project Sdk="Microsoft.NET.Sdk">

  <!-- Lives outside backend/'s central package management on purpose (experiments tree);
       versions are explicit here. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>14.0</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AssemblyName>VehicleDiagnostics.VirtualDevice</AssemblyName>
    <RootNamespace>VehicleDiagnostics.VirtualDevice</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../../../backend/src/Contracts/Contracts.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="MQTTnet" Version="5.2.0.1603" />
  </ItemGroup>

</Project>
