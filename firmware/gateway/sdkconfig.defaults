# Shared defaults so every checkout builds the same way. Generated sdkconfig is not committed.

# Warnings matter on a platform where a silent truncation is a wrong measurement.
CONFIG_COMPILER_WARN_WRITE_STRINGS=y

# The console is the only output channel in phase F0.
CONFIG_ESP_CONSOLE_UART_DEFAULT=y
CONFIG_LOG_DEFAULT_LEVEL_INFO=y

# app_main only supervises; the work happens in the link and consumer tasks.
CONFIG_ESP_MAIN_TASK_STACK_SIZE=4096

# The receive task must be able to outrank every consumer.
CONFIG_FREERTOS_HZ=1000
